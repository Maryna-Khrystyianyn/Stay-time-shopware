{% sw_extends '@Storefront/storefront/page/content/index.html.twig' %}

{% block base_main_inner %}
    {% if activeRoute == 'frontend.home.page' %}
        <!-- Hero Banner -->
        <section class="hero-banner">
            <div class="hero-content">
                <h1 class="hero-title">StayTime</h1>
                <p class="hero-subtitle">{{ "meine-minecraft.hero.subtitle"|trans|sw_sanitize }}</p>
                <p class="hero-link">{{ "meine-minecraft.hero.play-here"|trans|sw_sanitize }} staytime.b2t.world</p>
                
                <div class="scroll-down-wrapper">
                    <a class="hero-btn" id="hero-scroll-btn" href="#shop-content">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m9 12.75 3 3m0 0 3-3m-3 3v-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        {{ "meine-minecraft.hero.shop-now"|trans|sw_sanitize }}
                    </a>
                </div>
            </div>
        </section>
    {% endif %}

    {% set isContactPage = (activeRoute == 'frontend.contact.page') or (shopware.navigation.id == '019d86db8c0d78e6956d15e7b7e4f926') %}
    {% set isRulesPage = (shopware.navigation.id == '019d86db4e0a7fa1befac43a4a8d39b2') %}

    {# Custom Headers for Special Pages #}
    {% if isContactPage or isRulesPage %}
        <div class="container mt-5">
            <header class="section-header">
                {% if isContactPage %}
                    <h1 class="section-title">{{ "meine-minecraft.contact.header"|trans|sw_sanitize }}:</h1>
                {% elseif isRulesPage %}
                    <h1 class="section-title">{{ "meine-minecraft.rules.header"|trans|sw_sanitize }}:</h1>
                    <p class="section-subtitle">{{ "meine-minecraft.rules.subtitle"|trans|sw_sanitize }}</p>
                {% endif %}
            </header>

            {% if isContactPage %}
                <div class="contact-info-card mb-5">
                    <p class="instruction-text">
                        {{ "meine-minecraft.contact.instruction"|trans|sw_sanitize }}
                    </p>

                    <div class="contact-links">
                        <a href="https://t.me/staytimeofficial" class="contact-item telegram" target="_blank">
                            <i class="ph ph-telegram-logo"></i>
                            <span>Telegram: @staytimeofficial</span>
                        </a>
                        
                        <a href="https://discord.gg/staytime" class="contact-item discord" target="_blank">
                            <i class="ph ph-discord-logo"></i>
                            <span>Discord: StayTime Official</span>
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div id="shop-content" class="{% if isRulesPage %}is-rules-page{% endif %}">
        <!-- Add Phosphor Icons -->
        <script src="https://unpkg.com/@phosphor-icons/web"></script>
        
        {% set subcats = page.extensions.productsSubcategories|default([]) %}
        {% set mainCategoryId = subcats|length > 0 ? subcats|first.parentId : null %}
        {% set subcategoryIds = subcats|map(c => c.id) %}
        {% set showProductsMenu = (activeRoute == 'frontend.home.page') or (mainCategoryId and shopware.navigation.id == mainCategoryId) or (shopware.navigation.id in subcategoryIds) or (app.request.pathInfo|trim('/')|lower == 'products') %}

        {% if showProductsMenu %}
            <section class="product-listing-section">
                <header class="section-header">
                    <h2 class="section-title">{{ "meine-minecraft.categories.our-products"|trans|sw_sanitize }}:</h2>
                    
                    <nav class="category-filter-nav">
                        {# 1. All Products Link #}
                        {% set isAllProductsActive = (activeRoute == 'frontend.home.page') or (mainCategoryId and shopware.navigation.id == mainCategoryId) or (app.request.pathInfo|trim('/')|lower == 'products') %}
                        <a href="{{ path('frontend.home.page') }}#shop-content" class="filter-item {% if isAllProductsActive %}active{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 icon-grid">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                            </svg>
                            {{ "meine-minecraft.categories.all-products"|trans|sw_sanitize }}
                        </a>

                        {# 2. Dynamic Categories from PHP extension #}
                        {% for category in subcats %}
                            {% set name = category.translated.name %}
                            {% set customIcon = category.customFields.custom_meineminecraft_category_icon_svg|default('') %}
                            {% set isChildActive = shopware.navigation.id == category.id %}
                            
                            <a href="{{ category_url(category) }}#shop-content" class="filter-item {% if isChildActive %}active{% endif %}" title="{{ name }}">
                                {% if customIcon %}
                                    <i class="ph ph-{{ customIcon|trim }}"></i>
                                {% endif %}
                                {{ name }}
                            </a>
                        {% endfor %}
                    </nav>
                </header>
                
                {{ parent() }}
            </section>
        {% else %}
            {# This handles both Rules and Contact CMS content without duplication #}
            {{ parent() }}
        {% endif %}
    </div>
{% endblock %}
